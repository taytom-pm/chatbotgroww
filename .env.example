# ---------------------------------------------------------------------------
# Copy to .env and fill in. `.env` is gitignored; this template is not.
#     copy .env.example .env
#
# HOW THIS PROJECT USES THESE KEYS TODAY: it does not.
#
# The assistant is deliberately LLM-free (architecture.md, decision D1). Answers
# are extractive - sentences copied verbatim from the retrieved chunk - so a
# wrong answer is a test failure, not a hallucination. Nothing in mf_rag/,
# scripts/ or app.py reads an environment variable, so every key below is
# currently inert. They are here so the file is ready if that decision changes.
#
# If you wire an LLM into stage 6, two things will need attention first:
#   1. The grounding contract. Every answer must quote a retrieved span and cite
#      exactly one page. Free-form generation breaks that guarantee.
#   2. test_answers_are_grounded_in_retrieved_chunks and the 100 other tests
#      assume extractive output and will need to be revised, not deleted.
# ---------------------------------------------------------------------------

# Pick ONE provider. Delete the rest.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (open-weight models, free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# OpenAI-compatible local server (Ollama, LM Studio, vLLM). No key needed, but
# the app must not assume one provider's response shape over another's.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
